    <li>
        <table>
            <tabular halign="center" top="medium">
                <row left="medium" bottom="medium">
                <cell right="medium"></cell>
                <cell right="medium">Weight</cell>
                <cell right="medium"></cell>
                <cell right="medium">Standard Deviation</cell>
                </row><row left="medium" bottom="medium">
                <cell right="medium">Sum Weight of Beans</cell>
                <cell right="medium"></cell>
                <cell right="medium">Sum of Weight Standard Deviation</cell>
                <cell right="medium"></cell>
                </row>
                <row left="medium" bottom="medium">
                <cell right="medium">Mean<m>\sum(X_i)/80</m></cell>
                <cell right="medium"></cell>
                <cell right="medium">Sample Variation<m>\sum(d_i^2)/(80-1)</m></cell>
                <cell right="medium"></cell>
                </row>
                <row left="medium" bottom="medium">
                <cell right="medium" colspan="2">Standar Deviation<m>\sqrt{s^2}</m></cell>
                <cell right="medium" colspan="2"></cell>
                </row>
            </tabular>
        </table>
    </li>
